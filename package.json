{
  "name": "charmvilla-gallery-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "shopify:sync": "node scripts/shopify/sync.mjs",
    "shopify:prepare-zh": "node scripts/shopify/prepare-zh-copy.mjs",
    "shopify:migrate-zh": "node scripts/shopify/migrate-zh-copy.mjs",
    "shopify:test": "node --test scripts/shopify/catalog.test.mjs",
    "shopify:mcp": "node scripts/shopify/mcp.mjs",
    "shopify:mcp:check": "node scripts/shopify/check-mcp.mjs",
    "shopify:verify": "node scripts/shopify/verify.mjs",
    "test:api": "node --import ./tests/support/register-ts.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/run.mjs api",
    "test:e2e": "node --import ./tests/support/register-ts.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/run.mjs e2e",
    "test": "node --import ./tests/support/register-ts.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/run.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "graphql": "^16.13.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
