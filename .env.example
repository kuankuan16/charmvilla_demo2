# Shopify Headless: charmvilla admin handle; verified canonical API domain below.
SHOPIFY_STORE_DOMAIN=zcs0bg-10.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Dev Dashboard → CHARM VILLA Headless CMS. Server-only; tokens refresh automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy token instead of client credentials:
SHOPIFY_ADMIN_ACCESS_TOKEN=
NEXT_PUBLIC_COMMERCE_MODE=shopify
# Existing Shopify hosted customer accounts (passwordless). No classic password form.
SHOPIFY_CUSTOMER_ACCOUNT_URL=https://shopify.com/98570830188/account
NEXT_PUBLIC_ACCOUNTS_OPEN=true

NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Public Storefront token only, for Shopify consent API. Never use an Admin/private token.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
