# Shopify Storefront API (fill in Vercel → Project → Settings → Environment Variables, then redeploy)
SHOPIFY_STORE_DOMAIN=           # e.g. charm-villa.myshopify.com (no https://)
SHOPIFY_STOREFRONT_ACCESS_TOKEN= # Headless sales channel → Storefront API access token (public)
SHOPIFY_API_VERSION=2026-07      # optional
NEXT_PUBLIC_COMMERCE_MODE=local  # "shopify" once the values above are set; "local" keeps the cart in the browser with TWD list prices
